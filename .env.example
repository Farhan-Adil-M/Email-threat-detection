# Backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-in-production-use-at-least-32-bytes

# Demo
DEMO_MODE=false

# Storage
EVIDENCE_STORAGE_PATH=./data/storage
MAX_UPLOAD_SIZE=26214400

# Logging
LOG_LEVEL=INFO

# Frontend origin
CORS_ORIGINS=["http://localhost:3000"]

# Infrastructure intelligence: disabled | fixture | live
INTEL_MODE=disabled
INTEL_DNS_TIMEOUT=2.0

# Auth is disabled for the local demo by default. Enable for protected deployments.
AUTH_REQUIRED=false
DEMO_ANALYST_PASSWORD=change-me-analyst
DEMO_ADMIN_PASSWORD=change-me-admin
