# Backend
DATABASE_URL=postgresql+psycopg://sentinel:changeme@localhost:5432/sentinel
REDIS_URL=redis://:changeme@localhost:6379/0

# Security
SECRET_KEY=change-me-in-production-use-at-least-32-bytes

# Demo
DEMO_MODE=false

# Storage
EVIDENCE_STORAGE_PATH=./data/storage
MAX_UPLOAD_SIZE=26214400

# Logging
LOG_LEVEL=INFO

# Frontend origin
CORS_ORIGINS=["http://localhost:3000"]

# Infrastructure intelligence: disabled | fixture | live
INTEL_MODE=disabled
INTEL_DNS_TIMEOUT=2.0

# Auth is required by default. Set to false only for local demo without auth.
AUTH_REQUIRED=true
DEMO_ANALYST_PASSWORD=
DEMO_ADMIN_PASSWORD=

# Database credentials (used by docker-compose)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sentinel

# Redis credentials
REDIS_PASSWORD=changeme